#!/usr/bin/env python3
import sys
import signal
import select
import socket
import struct
from config import ler_configuracao
from registro import registrar_inicio
from protocolos import BROADCAST_MAC
from arp import TabelaARP
from roteamento import construir_tabela_rotas, processar_ipv4, tratar_falha_arp_icmp

SOL_PACKET = 263
PACKET_ADD_MEMBERSHIP = 1
PACKET_MR_PROMISC = 1


def main():
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(0))
    signal.signal(signal.SIGINT, lambda signum, frame: sys.exit(0))

    if len(sys.argv) < 2:
        sys.stderr.write("Uso: ./roteador <arquivo_de_configuracao>\n")
        sys.exit(1)

    config = ler_configuracao(sys.argv[1])

    # 1. Abre sockets AF_PACKET para cada interface
    socket_para_if = {}
    for nome_if, dados_if in config["interfaces"].items():
        s = socket.socket(socket.AF_PACKET, socket.SOCK_RAW, socket.htons(0x0003))
        s.bind((nome_if, 0))
        try:
            idx = socket.if_nametoindex(nome_if)
            s.setsockopt(SOL_PACKET, PACKET_ADD_MEMBERSHIP, struct.pack("iHH8s", idx, PACKET_MR_PROMISC, 0, b""))
        except Exception:
            pass
        dados_if["sock"] = s
        socket_para_if[s] = nome_if

    # 2. Emite registro de início
    registrar_inicio(config["nome"])

    # 3. Inicializa tabelas
    tabela_arp = TabelaARP()
    tabela_rotas = construir_tabela_rotas(config)
    lista_sockets = list(socket_para_if.keys())

    def callback_falha_arp(pacote_original, in_if_name):
        tratar_falha_arp_icmp(pacote_original, in_if_name, config, tabela_rotas, tabela_arp)

    while True:
        # Espera atividade nos sockets por até 0.05s
        prontos, _, _ = select.select(lista_sockets, [], [], 0.05)

        for s in prontos:
            quadro, addr = s.recvfrom(65535)

            # Ignora quadros enviados pelo próprio roteador ou curtos demais
            if addr[2] == 4 or len(quadro) < 14:
                continue

            in_if_name = socket_para_if[s]
            in_if = config["interfaces"][in_if_name]

            mac_dst, mac_src, ethertype = struct.unpack('!6s6sH', quadro[:14])

            # Só aceita se o destino for o MAC da interface ou broadcast
            if mac_dst != in_if["mac_bytes"] and mac_dst != BROADCAST_MAC:
                continue

            if ethertype == 0x0806:
                tabela_arp.tratar_quadro_arp(quadro, in_if_name, config)
            elif ethertype == 0x0800:
                processar_ipv4(quadro, in_if_name, config, tabela_rotas, tabela_arp)

        # Atualiza temporizadores do ARP (expiração do cache e retentativas/falha de resolução)
        tabela_arp.verificar_temporizadores(config, callback_falha_arp)


if __name__ == "__main__":
    main()
